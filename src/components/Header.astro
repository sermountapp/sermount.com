---
import { PAGES, SHOW_SIGN_IN, SIGN_IN_URL, BETA_PATH, betaBuilt } from '../config';
const nav = PAGES.filter((p) => p.nav && p.built);
const here = Astro.url.pathname.replace(/\.html$/, '');
const showBeta = betaBuilt && here !== BETA_PATH && here !== '/thanks';
---
<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-label="Sermount home">Sermount</a>
    <nav aria-label="Main">
      {nav.map((p) => <a class="nav-link" href={p.path}>{p.label}</a>)}
      {SHOW_SIGN_IN && <a class="nav-link" href={SIGN_IN_URL} rel="nofollow">Sign in</a>}
      {showBeta && <a class="btn btn-sm" href={BETA_PATH}>Join the beta</a>}
    </nav>
  </div>
</header>

<style>
  .site-header { padding: 28px 0; }
  .wrap { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .wordmark { font: 400 27px/1 var(--serif); letter-spacing: -0.01em; text-decoration: none; color: var(--ink); }
  nav { display: flex; gap: 32px; align-items: center; font-size: 15px; }
  .nav-link { text-decoration: none; color: var(--ink-soft); }
  .nav-link:hover { color: var(--ink); }
  .btn-sm { padding: 12px 16px; font-size: 15px; }
  @media (max-width: 860px) {
    .site-header { padding: 20px 0; }
    .nav-link { display: none; }
  }
</style>
