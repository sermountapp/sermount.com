---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on sermount.com." noindex>
  <section class="notfound">
    <div class="wrap">
      <p class="label">404</p>
      <h1>There's no page at this address.</h1>
      <p class="lead">It may have moved, or the link may have a typo.</p>
      <p class="back"><a class="link" href="/">Go to the home page</a></p>
    </div>
  </section>
</Base>

<style>
  .notfound { padding: 72px 0 var(--section); }
  h1 { max-width: 16ch; }
  .lead { margin-top: 24px; }
  .back { margin-top: 36px; }
</style>
