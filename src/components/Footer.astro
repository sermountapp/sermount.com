---
import { PAGES } from '../config';
const links = PAGES.filter((p) => p.built);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <span class="wordmark">Sermount</span>
    {links.length > 0 && (
      <nav aria-label="Footer">
        {links.map((p) => <a href={p.path}>{p.label}</a>)}
      </nav>
    )}
    <span>© {year} Sermount</span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); padding: 40px 0 56px; font-size: 14px; color: var(--ink-soft); }
  .wrap { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; align-items: baseline; }
  .wordmark { font: 500 20px/1 var(--serif); color: var(--ink); }
  nav { display: flex; gap: 24px; flex-wrap: wrap; }
  nav a { text-decoration: none; }
  nav a:hover { color: var(--ink); }
</style>
